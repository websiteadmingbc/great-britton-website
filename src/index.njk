layout: base.njk
title: "Kitchen & Bath Remodels in San Jose | Great Britton"
description: "Kitchen and bath remodeling in San Jose and across the Bay Area. Licensed General B contractor CSLB #1025488. Free estimates: (510) 432-8461."
permalink: /
includeReviewsWidget: true
navSection: home
---

<section class="hero hero-redesign" id="hero">
  <div class="container hero-stage">
    <div class="hero-copy">
      <div class="eyebrow">Licensed Bay Area GC</div>
      <h1 class="hero-title">
        <span class="hero-line">Kitchen &amp; Bath</span>
        <span class="hero-line"><em>Remodeling in</em></span>
        <span class="hero-line">San Jose.</span>
      </h1>
      <p class="hero-desc">Remodels, ADUs and additions from the South Bay to the East Bay. One San Jose main office handles every estimate, contract and schedule.</p>
      <div class="actions">
        <a class="btn outline" href="tel:{{ site.phoneTel }}">Call {{ site.phoneDisplay }}</a>
        <a class="btn" href="/contact/">Request a Free Estimate</a>
      </div>
    </div>
    <div class="area-check" id="area-check">
      <p class="area-check-label">Do we build in your area?</p>
      <form action="/contact/" class="area-check-row" id="area-check-form" method="get">
        <input aria-label="City or ZIP" autocomplete="address-level2" id="area-query" name="area" placeholder="City or ZIP" type="text"/>
        <button class="btn" type="submit">Check</button>
      </form>
      <div aria-label="Areas we service" class="area-check-chips">
        <span class="area-check-chips-label">We serve</span>
        <div class="area-check-chips-list">
          <button data-area="San Francisco" type="button">San Francisco</button>
          <button data-area="San Mateo County, Bay side" type="button">Peninsula</button>
          <button data-area="San Mateo County, coast" type="button">Coastside</button>
          <button data-area="Santa Clara County" type="button">Santa Clara</button>
          <button data-area="Santa Cruz County" type="button">Santa Cruz</button>
        </div>
      </div>
      <div aria-live="polite" class="area-check-result" hidden id="area-check-result"></div>
    </div>
  </div>
</section>

<div class="trust-strip" aria-label="Company highlights">
  <div class="container trust-strip-grid">
    <div class="trust-item"><strong>{{ site.license }}</strong><span>Licensed · <a class="cslb-link" href="{{ site.licenseUrl }}" rel="noopener" target="_blank">Verify ↗</a></span></div>
    <div class="trust-item"><strong>1 point of contact</strong><span>San Jose runs every project</span></div>
    <div class="trust-item"><strong>2 locations</strong><span>San Jose · Alameda / East Bay</span></div>
    <div class="trust-item"><strong>Free consultation</strong><span>Written estimate up front</span></div>
  </div>
</div>

<section class="section services" id="services">
  <div class="container">
    <div class="sectionhead">
