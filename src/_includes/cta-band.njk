<section class="section cta-band">
  <div class="container cta-band-inner">
    <div>
      <div class="eyebrow">{{ ctaEyebrow or 'Next step' }}</div>
      <h2>{{ ctaHeading or 'Request a free remodeling estimate.' }}</h2>
