<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}"/>
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}"/>
  <meta name="robots" content="index, follow, max-image-preview:large"/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content="{{ site.domain }}{{ page.url }}"/>
  <meta property="og:title" content="{{ title }}"/>
  <meta property="og:description" content="{{ description }}"/>
  <meta property="og:image" content="{{ site.domain }}{{ ogImage or site.ogImage }}"/>
  <meta property="og:image:alt" content="{{ ogImageAlt or 'Great Britton Construction project photo' }}"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="{{ title }}"/>
  <meta name="twitter:description" content="{{ description }}"/>
  <meta name="twitter:image" content="{{ site.domain }}{{ ogImage or site.ogImage }}"/>
  <meta name="theme-color" content="#0a0c0d"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="icon" href="/assets/favicon.png" sizes="256x256" type="image/png"/>
  <link rel="icon" href="/assets/favicon-48.png" sizes="48x48" type="image/png"/>
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png"/>
  <link rel="stylesheet" href="/assets/style.css?v=multipage-2"/>
  <link rel="stylesheet" href="/assets/multipage.css?v=3"/>
  {% include "analytics.njk" %}
  {% include "schema-org.njk" %}
  {% if faqSchema %}
  <script type="application/ld+json">{{ faqSchema | json | safe }}</script>
  {% endif %}
  {% if serviceSchema %}
  <script type="application/ld+json">{{ serviceSchema | json | safe }}</script>
  {% endif %}
  {% if breadcrumbSchema %}
  <script type="application/ld+json">{{ breadcrumbSchema | json | safe }}</script>
  {% endif %}
</head>
<body class="has-topbar has-mobile-callbar{% if bodyClass %} {{ bodyClass }}{% endif %}">
  {% include "topbar.njk" %}
  {% include "header.njk" %}
  <main id="top">
    {{ content | safe }}
  </main>
  {% include "mobile-callbar.njk" %}
  {% include "footer.njk" %}
  <script src="/assets/supabase-config.js"></script>
  <script src="/assets/main.js"></script>
  <script src="/assets/multipage.js"></script>
  {% if includeReviewsWidget %}
  <script defer src="https://widgets.sociablekit.com/reviews/widget.js"></script>
  {% endif %}
</body>
</html>
