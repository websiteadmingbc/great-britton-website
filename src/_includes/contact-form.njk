<form action="{{ site.formAction }}" class="inquiry-form" id="inquiry-form" method="POST" novalidate>
  <input name="_subject" type="hidden" value="New inquiry — greatbrittongc.com"/>
  <input name="submission_type" type="hidden" value="main-site-inquiry"/>
  <input name="landing_page" type="hidden" value="{{ page.url }}"/>
  <div class="hp" aria-hidden="true"><label>Website <input autocomplete="off" name="company_website" tabindex="-1" type="text"/></label></div>
  <div class="form-grid">
    <label class="span-2">How did you hear about us? *
      <select aria-required="true" name="how_heard" required>
        <option disabled selected value="">Select…</option>
        <option>Nextdoor Ad</option>
        <option>Facebook</option>
        <option>Yelp</option>
        <option>Internet Search</option>
        <option>Word of mouth</option>
        <option>Other</option>
      </select>
    </label>
    <label>Project type
      <select name="project_type" required>
        <option value="">Select…</option>
        <option{% if formProjectDefault == 'Kitchen remodel' %} selected{% endif %}>Kitchen remodel</option>
        <option{% if formProjectDefault == 'Bathroom remodel' %} selected{% endif %}>Bathroom remodel</option>
        <option>Kitchen + bath</option>
        <option{% if formProjectDefault == 'ADU / garage conversion' %} selected{% endif %}>ADU / garage conversion</option>
        <option{% if formProjectDefault == 'Addition' %} selected{% endif %}>Addition</option>
        <option>Other</option>
      </select>
    </label>
    <label>City<input autocomplete="address-level2" name="city" placeholder="e.g. San Jose" required type="text"/></label>
    <label>Budget range
      <select name="budget" required>
        <option value="">Select…</option>
        <option>Under $10K</option>
        <option>$10K–$25K</option>
        <option>$25K–$60K</option>
        <option>$60K–$150K</option>
        <option>$150K+</option>
        <option>Not sure yet</option>
      </select>
    </label>
    <label>Timeline
      <select name="timeline" required>
        <option value="">Select…</option>
        <option>As soon as possible</option>
        <option>1–3 months</option>
        <option>3–6 months</option>
        <option>6+ months / just planning</option>
      </select>
    </label>
    <label>Name<input autocomplete="name" name="name" required type="text"/></label>
    <label>Phone<input autocomplete="tel" name="phone" placeholder="Phone or email required" type="tel"/></label>
    <label class="span-2">Email<input autocomplete="email" name="email" type="email"/></label>
  </div>
  <div class="form-actions">
    <button class="btn" type="submit">Request a Free Consultation</button>
    <a class="form-call" href="tel:{{ site.phoneTel }}">or call {{ site.phoneDisplay }}</a>
  </div>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
